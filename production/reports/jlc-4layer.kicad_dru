(version 1)
(rule "JLC min track" (constraint track_width (min 0.09mm)))
(rule "JLC min clearance" (condition "A.Type != 'Zone' && B.Type != 'Zone'") (constraint clearance (min 0.09mm)))
(rule "JLC via hole" (condition "A.Type == 'Via'") (constraint hole_size (min 0.15mm)))
(rule "JLC via ring" (condition "A.Type == 'Via'") (constraint annular_width (min 0.05mm)))
(rule "JLC PTH ring" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.15mm)))
(rule "JLC hole to copper" (constraint hole_clearance (min 0.2mm)))
(rule "JLC PTH hole to copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.28mm)))
(rule "JLC via to via" (constraint hole_to_hole (min 0.2mm)))
(rule "JLC PTH hole to hole" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "JLC copper to edge" (constraint edge_clearance (min 0.2mm)))
(rule "JLC SMD pad to pad" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net") (constraint clearance (min 0.15mm)))
(rule "JLC silk text" (layer "?.Silkscreen") (constraint text_height (min 1.0mm)))
(rule "JLC silk width" (layer "?.Silkscreen") (constraint text_thickness (min 0.15mm)))
